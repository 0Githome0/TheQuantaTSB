                    'Fibonacci retracement'
                ],
                'outlooks': [
                    'potential upside', 
                    'possible reversal', 
                    'continued momentum',
                    'range-bound trading',
                    'increased volatility'
                ]
            }
        ]
        
        sources = [
            "ForexLive", "DailyFX", "FXStreet", "Bloomberg", "Reuters", 
            "Investing.com", "MarketWatch", "Financial Times", "Wall Street Journal"
        ]
        
        # Generate 5-15 random news items
        num_items = random.randint(5, 15)
        mock_news = []
        
        for i in range(num_items):
            # Create random timestamp within last 24 hours
            hours_ago = random.randint(0, 24)
            minutes_ago = random.randint(0, 59)
            published_time = (datetime.now() - timedelta(hours=hours_ago, minutes=minutes_ago)).strftime("%Y-%m-%d %H:%M:%S")
            
            # Choose random pair
            chosen_pair = random.choice(pairs)
            
            # Choose random news template
            template = random.choice(news_templates)
            
            # Fill in the template with random values
            if 'central_bank' in template['title_template']:
                # For central bank news, match the central bank to the currency pair
                if 'EUR' in chosen_pair:
                    central_bank = 'European Central Bank'
                elif 'GBP' in chosen_pair:
                    central_bank = 'Bank of England'
                elif 'JPY' in chosen_pair:
                    central_bank = 'Bank of Japan'
                elif 'AUD' in chosen_pair:
                    central_bank = 'Reserve Bank of Australia'
                elif 'CAD' in chosen_pair:
                    central_bank = 'Bank of Canada'
                else:
                    central_bank = 'Federal Reserve'
                    
                title = template['title_template'].format(
                    central_bank=central_bank,
                    pair=chosen_pair,
                    direction=random.choice(template['directions'])
                )
            elif 'pattern' in template['title_template']:
                title = template['title_template'].format(
                    pair=chosen_pair,
                    pattern=random.choice(template['patterns']),
                    outlook=random.choice(template['outlooks'])
                )
            else:
                title = template['title_template'].format(
                    pair=chosen_pair,
                    direction=random.choice(template['directions']),
                    factor=random.choice(template['factors'])
                )
                
            # Add some randomness to headlines
            if random.random() < 0.2:
                title = f"BREAKING: {title}"
            elif random.random() < 0.3:
                title = f"ANALYSIS: {title}"
                
            # Generate a more realistic URL
            source = random.choice(sources)
            slug = title.lower().replace(' ', '-').replace(':', '').replace(',', '')[:50]
            url = f"https://www.{source.lower().replace(' ', '')}.com/forex/{slug}"
                
            # Create sentiment data with realistic probabilities
            # Bias news about pairs according to the direction words
            sentiment_score = 0.0
            if any(word in title.lower() for word in ['rises', 'recovers', 'surges', 'positively', 'strengthen', 'bullish', 'upside']):
                sentiment_score = random.uniform(0.3, 0.8)
            elif any(word in title.lower() for word in ['falls', 'slips', 'drops', 'negatively', 'weaken', 'reversal']):
                sentiment_score = random.uniform(-0.8, -0.3)
            else:
                sentiment_score = random.uniform(-0.2, 0.2)
                
            sentiment_label = "neutral"
            if sentiment_score > 0.25:
                sentiment_label = "positive"
            elif sentiment_score < -0.25:
                sentiment_label = "negative"
            else:
                sentiment_label = "neutral"
                
            mock_news.append({
                'title': title,
                'url': url,
                'published': published_time,
                'source': source,
                'sentiment': {
                    'combined_score': sentiment_score,
                    'sentiment_label': sentiment_label
                }
            })
    
        return mock_news

    def _is_relevant_to_pair(self, text: str, pair: str) -> bool:
        """
        Determine if a text is relevant to a specific trading pair.
        
        Args:
            text: The text to analyze
            pair: Trading pair (e.g., 'BTCUSD')
            
        Returns:
            Boolean indicating relevance
        """
        if not text or not pair:
            return False
            
        # Extract symbols from the pair
        base, quote = self._extract_base_quote(pair)
        
        # Normalize text
        text = text.lower()
        
        # Check for the trading pair or its components in the text
        if pair.lower() in text:
            return True
            
        # Check for base currency
        if base.lower() in text:
            return True
            
        # Check for common names of cryptocurrencies
        crypto_names = {
            'btc': ['bitcoin', 'btc'],
            'eth': ['ethereum', 'eth'],
            'xrp': ['ripple', 'xrp'],
            'ltc': ['litecoin', 'ltc'],
            'bnb': ['binance', 'bnb'],
            'ada': ['cardano', 'ada'],
            'sol': ['solana', 'sol'],
            'doge': ['dogecoin', 'doge']
        }
        
        # Check if base currency has common names and if they appear in text
        base_lower = base.lower()
        if base_lower in crypto_names:
            for name in crypto_names[base_lower]:
                if name in text:
                    return True
        
        return False
        
    def _extract_base_quote(self, pair: str) -> Tuple[str, str]:
        """
        Extract base and quote currencies from a trading pair.
        
        Args:
            pair: Trading pair (e.g., 'BTCUSD')
            
        Returns:
            Tuple of (base_currency, quote_currency)
        """
        # Common quote currencies
        quote_currencies = ['usd', 'usdt', 'usdc', 'eur', 'gbp', 'jpy', 'aud', 'cad']
        
        pair = pair.lower()
        
        # Try standard format with common quote currencies
        for quote in quote_currencies:
            if pair.endswith(quote):
                base = pair[:-len(quote)]
                return base, quote
        
        # If no match, use simple split at position 3 or 4
        if len(pair) >= 6:
            return pair[:3], pair[3:]
        else:
            # Default split in the middle for unknown pairs
            mid = len(pair) // 2
            return pair[:mid], pair[mid:]

    class RateLimiter:
        def __init__(self, calls_per_second=1):
            self.calls_per_second = calls_per_second
            self.last_call = {}
            self.tokens = {}
            self.max_tokens = 5  # Maximum number of tokens per domain
            self.lock = asyncio.Lock()

        async def acquire(self, domain):
            async with self.lock:
                current_time = time.time()
                
                # Initialize tokens for new domains
                if domain not in self.tokens:
                    self.tokens[domain] = self.max_tokens
                    self.last_call[domain] = current_time - (1.0 / self.calls_per_second)
                
                # Replenish tokens based on time passed
                time_passed = current_time - self.last_call[domain]
                new_tokens = min(
                    self.max_tokens,
                    self.tokens[domain] + time_passed * self.calls_per_second
                )
                self.tokens[domain] = new_tokens
                
                # If we have less than 1 token, calculate wait time
                if self.tokens[domain] < 1:
                    wait_time = (1 - self.tokens[domain]) / self.calls_per_second
                    await asyncio.sleep(wait_time)
                    self.tokens[domain] = 1
                
                # Consume one token
                self.tokens[domain] -= 1
                self.last_call[domain] = current_time

    def _default_sentiment(self) -> Dict:
        """
        Return a default neutral sentiment when no news is available.
        
        Returns:
            Dictionary with neutral sentiment values
        """
        return {
            'average_sentiment': 0.0,
            'sentiment_label': 'neutral',
            'distribution': {'positive': 0.0, 'neutral': 1.0, 'negative': 0.0},
            'total_articles': 0,
            'pair_relevant_count': 0,
            'sources': [],
            'freshness': {'newest': None, 'oldest': None}
        }
        
    async def analyze_pair_sentiment(self, pair: str) -> Dict:
        """
        Analyzes sentiment for a specific trading pair by fetching news
        and performing sentiment analysis on the news content.
        
        Args:
            pair: The trading pair to analyze sentiment for
            
        Returns:
            Dict: Sentiment analysis results including score, label, confidence,
                 news_count, and keywords.
        """
        log.info(f"Analyzing sentiment for {pair}...")
        
        # Initialize default sentiment result
        sentiment_result = self._default_sentiment()
        
        try:
            # Fetch news for the pair
            news_items = await self.fetch_market_news(pair=pair)
            
            if not news_items:
                log.warning(f"No news found for {pair}, returning neutral sentiment.")
                return sentiment_result
                
            # Extract sentiment scores from news items
            sentiment_scores = []
            keywords = set()
            
            for item in news_items:
                if 'sentiment' in item and 'combined_score' in item['sentiment']:
                    score = item['sentiment']['combined_score']
                    sentiment_scores.append(score)
                    
                    # Extract potential keywords from title
                    if 'title' in item:
                        # Simple keyword extraction (could be improved with NLP techniques)
                        title_words = item['title'].lower().split()
                        important_words = [w for w in title_words if len(w) > 4 and w not in ['about', 'after', 'their', 'these', 'those', 'while']]
                        keywords.update(important_words[:3])  # Add up to 3 important words
            
            # Calculate overall sentiment if we have scores
            if sentiment_scores:
                # Use weighted average with more recent news having higher weight
                weights = np.linspace(0.5, 1.0, len(sentiment_scores))
                avg_sentiment = np.average(sentiment_scores, weights=weights)
                
                # Determine sentiment label
                sentiment_label = 'neutral'
                if avg_sentiment >= 0.25:
                    sentiment_label = 'positive'
                elif avg_sentiment <= -0.25:
                    sentiment_label = 'negative'
                
                # Calculate confidence based on number of news items and consistency
                news_count = len(sentiment_scores)
                score_std = np.std(sentiment_scores) if len(sentiment_scores) > 1 else 0.5
                consistency_factor = max(0.1, 1.0 - (score_std * 2))  # Higher consistency = higher confidence
                quantity_factor = min(1.0, news_count / 10)  # More news = higher confidence, caps at 10 items
                confidence = 0.3 + (0.7 * (consistency_factor * 0.7 + quantity_factor * 0.3))
                
                # Update sentiment result
                sentiment_result.update({
                    'sentiment_score': round(avg_sentiment, 3),
                    'sentiment_label': sentiment_label,
                    'confidence': round(confidence, 2),
                    'news_count': news_count,
                    'keywords': list(keywords)[:5]  # Top 5 keywords
                })
                
                log.info(f"Sentiment analysis for {pair} complete: {sentiment_label} ({avg_sentiment:.3f}), confidence: {confidence:.2f}, based on {news_count} news items")
                
            else:
                log.warning(f"No sentiment scores could be extracted from news for {pair}")
                
        except Exception as e:
            log.error(f"Error during sentiment analysis for {pair}: {e}", exc_info=True)
            sentiment_result['error'] = f"Sentiment analysis failed: {str(e)}"
            
        return sentiment_result
        
    def detect_false_signals(self, data: pd.DataFrame, indicators: Dict) -> bool:
        """
        Detects potential false or anomalous trading signals based on technical 
        patterns, price action, or indicator divergences.
        
        Args:
            data: DataFrame with recent market data
            indicators: Dictionary of technical indicators
            
        Returns:
            bool: True if the signal is likely false/anomalous, False otherwise
        """
        log.debug("Checking for false signal patterns...")
        
        try:
            # Ensure we have enough data
            if data is None or data.empty or len(data) < 5:
                log.warning("Insufficient data for false signal detection")
                return False
                
            # Extract recent price data for analysis
            recent_data = data.tail(10)
            
            # 1. Check for RSI divergence (if RSI is available)
            if 'rsi' in indicators and not indicators['rsi'].empty:
                rsi = indicators['rsi'].dropna()
                if len(rsi) >= 10:
                    # Check bullish divergence: price making lower lows but RSI making higher lows
                    price_lower_low = (recent_data['low'].iloc[-1] < recent_data['low'].iloc[-3])
                    rsi_higher_low = (rsi.iloc[-1] > rsi.iloc[-3])
                    
                    # Check bearish divergence: price making higher highs but RSI making lower highs
                    price_higher_high = (recent_data['high'].iloc[-1] > recent_data['high'].iloc[-3])
                    rsi_lower_high = (rsi.iloc[-1] < rsi.iloc[-3])
                    
                    if (price_lower_low and rsi_higher_low) or (price_higher_high and rsi_lower_high):
                        log.info("Detected potential false signal: RSI divergence")
                        return True
            
            # 2. Check for price spikes (potential reversal)
            if len(recent_data) >= 3:
                # Calculate candle sizes as percentage of average
                candle_sizes = abs(recent_data['close'] - recent_data['open'])
                avg_size = candle_sizes.mean()
                latest_size = candle_sizes.iloc[-1]
                
                # If latest candle is more than 3x the average size, it could be a spike
                if latest_size > (3 * avg_size):
                    log.info("Detected potential false signal: Price spike (abnormal candle size)")
                    return True
            
            # 3. Check for false breakouts (price quickly returning inside range)
            if len(recent_data) >= 5:
                # Calculate recent high and low
                recent_high = recent_data['high'].iloc[-5:-2].max()
                recent_low = recent_data['low'].iloc[-5:-2].min()
                
                # Check if price initially broke out but then returned to the range
                broke_high = recent_data['high'].iloc[-2] > recent_high
                broke_low = recent_data['low'].iloc[-2] < recent_low
                returned_to_range = (recent_data['close'].iloc[-1] < recent_high and 
                                     recent_data['close'].iloc[-1] > recent_low)
                
                if (broke_high or broke_low) and returned_to_range:
                    log.info("Detected potential false signal: Failed breakout")
                    return True
            
            # 4. Check for overbought/oversold conditions
            if 'rsi' in indicators and not indicators['rsi'].empty:
                last_rsi = indicators['rsi'].iloc[-1]
                if (last_rsi > 80) or (last_rsi < 20):
                    log.info(f"Detected potential false signal: Extreme RSI ({last_rsi:.1f})")
                    return True
            
            # No false signal patterns detected
            return False
            
        except Exception as e:
            log.error(f"Error occurred during false signal (anomaly) detection: {e}", exc_info=False)
            return False  # Default to not blocking the signal on error

    def _generate_mock_news(self, pair: Optional[str] = None) -> List[Dict]:
        """
        Generate mock financial news when real sources are unavailable.
        
        Args:
            pair: Optional trading pair to create relevant news for
            
        Returns:
            List of mock news items with appropriate structure
        """
        log.warning(f"Generating mock news for {pair if pair else 'general market'}")
        
        # Get current timestamp for news
        now = datetime.now()
        
        # Create relevant title based on pair
        titles = [
            "Market volatility continues as traders await key economic data",
            "Analysts predict sideways trading for the week ahead",
            "Technical indicators suggest potential breakout coming soon",
            "Trading volumes remain low amid cautious market sentiment",
            "Market participants eye central bank comments for direction"
        ]
        
        # If specific pair, add more relevant titles
        if pair:
            base_curr = pair[:3] if len(pair) >= 3 else ""
            quote_curr = pair[3:6] if len(pair) >= 6 else ""
            
            if base_curr in ['BTC', 'ETH', 'XRP', 'SOL']:
                crypto_titles = [
                    f"{base_curr} stabilizes after weekend volatility",
                    f"Institutional interest in {base_curr} continues to grow",
                    f"Technical analysis: {base_curr} approaching key resistance level",
                    f"On-chain metrics show increasing {base_curr} adoption",
                    f"{base_curr} trading volume spikes amid market uncertainty"
                ]
                titles.extend(crypto_titles)
            else:
                forex_titles = [
                    f"{base_curr}/{quote_curr} trading within established range",
                    f"Economic data could impact {base_curr} pairs this week",
                    f"{base_curr} strength continues against major currencies",
                    f"Traders watching {base_curr}/{quote_curr} technical patterns",
                    f"Market awaits volatility in {base_curr} crosses"
                ]
                titles.extend(forex_titles)
        
        # Generate random sentiment values
        sentiments = [
            {"combined_score": 0.32, "sentiment_label": "positive"},
            {"combined_score": -0.27, "sentiment_label": "negative"},
            {"combined_score": 0.05, "sentiment_label": "neutral"},
            {"combined_score": 0.15, "sentiment_label": "neutral"},
            {"combined_score": -0.12, "sentiment_label": "neutral"}
        ]
        
        # Generate 5-8 mock news items
        num_items = random.randint(5, 8)
        mock_news = []
        
        for i in range(num_items):
            # Randomize publication time within last 24 hours
            hours_ago = random.randint(0, 24)
            pub_time = (now - timedelta(hours=hours_ago)).strftime("%Y-%m-%d %H:%M:%S")
            
            # Create news item
            news_item = {
                "title": random.choice(titles),
                "url": f"https://mock-financial-news.com/article/{uuid.uuid4().hex[:8]}",
                "published": pub_time,
                "source": random.choice(["MarketNews", "FinancialTimes", "TradingNews", "InvestorDaily", "Finnhub"]),
                "sentiment": random.choice(sentiments)
            }
            
            mock_news.append(news_item)
        
        log.info(f"Generated {len(mock_news)} mock news items")
        return mock_news

    def analyze_news_sentiment(self, news_items: List[Dict], pair: str = None) -> Dict:
        """
        Analyze sentiment of news items, optionally filtered by trading pair relevance.
        
        Args:
            news_items: List of news items to analyze
            pair: Optional trading pair to filter relevant news
            
        Returns:
            Dict containing sentiment analysis results
        """
        log.info(f"Analyzing sentiment for {len(news_items)} news items" + 
                 (f" related to {pair}" if pair else ""))
                 
        # Return default if no news items
        if not news_items:
            log.warning("No news items provided for sentiment analysis")
            return self._default_sentiment()
            
        # Initialize tracking variables
        sentiment_scores = []
        positive_count = 0
        negative_count = 0
        neutral_count = 0
        sources = set()
        timestamps = []
        pair_relevant_count = 0
        
        # Process each news item
        for item in news_items:
            # Extract sentiment score - either from pre-calculated data or calculate basic sentiment
            if 'sentiment' in item and 'combined_score' in item['sentiment']:
                sentiment_score = item['sentiment']['combined_score']
                sentiment_label = item['sentiment']['sentiment_label']
            elif 'title' in item:
                sentiment_score, sentiment_label = self._extract_basic_sentiment(item['title'])
            else:
                continue  # Skip items without sentiment or title
                
            # Track sentiment distribution
            if sentiment_label == 'positive':
                positive_count += 1
            elif sentiment_label == 'negative':
                negative_count += 1
            else:
                neutral_count += 1
                
            # Check if news is relevant to the pair
            is_relevant = True
            if pair:
                is_relevant = (
                    self._is_relevant_to_pair(item.get('title', ''), pair) or
                    self._is_relevant_to_pair(item.get('description', ''), pair)
                )
                if is_relevant:
                    pair_relevant_count += 1
            
            # Add sentiment score if relevant (or if we're not filtering by pair)
            if not pair or is_relevant:
                sentiment_scores.append(sentiment_score)
                
            # Track news sources
            if 'source' in item:
                sources.add(item['source'])
                
            # Track timestamps for freshness analysis
            if 'published' in item:
                try:
                    # Handle different timestamp formats
                    if isinstance(item['published'], (int, float)):
                        timestamps.append(datetime.fromtimestamp(item['published']))
                    else:
                        timestamps.append(datetime.fromisoformat(item['published'].replace('Z', '+00:00')))
                except (ValueError, TypeError):
                    # If we can't parse the timestamp, ignore it
                    pass
        
        # Calculate average sentiment
        if sentiment_scores:
            # Weight more recent news higher if we have timestamps
            if timestamps:
                # Sort by timestamp, newest first
                pairs = sorted(zip(timestamps, sentiment_scores), key=lambda x: x[0], reverse=True)
                timestamps, sentiment_scores = zip(*pairs)
                
                # Create linearly decreasing weights, newest news gets highest weight
                weights = np.linspace(1.0, 0.5, len(sentiment_scores))
                avg_sentiment = float(np.average(sentiment_scores, weights=weights))
            else:
                # Simple average if no timestamps
                avg_sentiment = float(np.mean(sentiment_scores))
        else:
            avg_sentiment = 0.0
            
        # Determine overall sentiment label
        sentiment_label = 'neutral'
        if avg_sentiment >= 0.25:
            sentiment_label = 'positive'
        elif avg_sentiment <= -0.25:
            sentiment_label = 'negative'
            
        # Calculate distribution percentages
        total_count = positive_count + negative_count + neutral_count
        if total_count > 0:
            distribution = {
                'positive': positive_count / total_count,
                'neutral': neutral_count / total_count,
                'negative': negative_count / total_count
            }
        else:
            distribution = {'positive': 0.0, 'neutral': 1.0, 'negative': 0.0}
            
        # Prepare result
        result = {
            'average_sentiment': round(avg_sentiment, 3),
            'sentiment_label': sentiment_label,
            'distribution': {k: round(v, 2) for k, v in distribution.items()},
            'total_articles': total_count,
            'pair_relevant_count': pair_relevant_count,
            'sources': list(sources),
            'freshness': {
                'newest': max(timestamps).isoformat() if timestamps else None,
                'oldest': min(timestamps).isoformat() if timestamps else None
            }
        }
        
        log.info(f"Sentiment analysis complete: {sentiment_label} ({avg_sentiment:.3f}), " +
                f"based on {total_count} news items" +
                (f", {pair_relevant_count} relevant to {pair}" if pair else ""))
                
        return result
    
    def _extract_basic_sentiment(self, text: str) -> Tuple[float, str]:
        """
        Extract basic sentiment from text using keyword matching.
        
        Args:
            text: The text to analyze
            
        Returns:
            Tuple of (sentiment_score, sentiment_label)
        """
        # Lists of keywords for sentiment analysis
        positive_words = [
            'bullish', 'rally', 'gain', 'grows', 'rise', 'rising', 'soars', 'up', 'upside',
            'support', 'strong', 'strength', 'positive', 'profit', 'opportunity', 'rebound',
            'recovery', 'breakthrough', 'outperform', 'beat', 'exceeded', 'momentum', 'confident'
        ]
        
        negative_words = [
            'bearish', 'drop', 'falls', 'falling', 'plunge', 'plummet', 'down', 'downside',
            'resistance', 'weak', 'weakness', 'negative', 'loss', 'risk', 'correction',
            'decline', 'pressure', 'underperform', 'missed', 'disappointing', 'concern', 'cautious'
        ]
        
        # Normalize text
        text = text.lower()
        
        # Count occurrences of sentiment keywords
        positive_count = sum(1 for word in positive_words if word in text)
        negative_count = sum(1 for word in negative_words if word in text)
        
        # Calculate sentiment score
        sentiment_score = (positive_count - negative_count) / (positive_count + negative_count + 1)
        
        # Determine sentiment label
        if sentiment_score > 0.2:
            sentiment_label = 'positive'
        elif sentiment_score < -0.2:
            sentiment_label = 'negative'
        else:
            sentiment_label = 'neutral'
        
        return sentiment_score, sentiment_label

